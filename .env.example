PORT=3847
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://saip-sync.onrender.com
ADMIN_EMAIL=you@example.com

# Git-backed durable storage (survives Render free-tier disk wipe)
# Use a PRIVATE GitHub repo. Create a fine-grained PAT with Contents: Read+Write.
GIT_DATA_ENABLED=true
GIT_DATA_REPO=https://github.com/YOUR_USER/saip-sync-data.git
GIT_DATA_BRANCH=main
GIT_DATA_TOKEN=github_pat_xxxxxxxx
GIT_DATA_USER=saip-sync-bot
GIT_DATA_EMAIL=saip-sync@users.noreply.github.com

# Debounce git pushes after local writes (ms). Default 15s.
GIT_PUSH_DEBOUNCE_MS=15000
